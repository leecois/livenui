{
  "name": "livenui-ui",
  "version": "0.0.2",
  "description": "The framework for building a documentation website in Next.js",
  "keywords": [
    "NextJs",
    "Docs"
  ],
  "type": "module",
  "exports": {
    "./registry": "./src/_registry/index.ts",
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "files": [
    "dist/*",
    "LICENSE-ICONS"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-native/bin/tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "concurrently \"node ../../node_modules/typescript-native/bin/tsc -w --project tsconfig.build.json\" \"tsc-alias -w -p tsconfig.build.json\"",
    "lint": "bunx biome lint --write --diagnostic-level=error",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.15.18",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.3.8",
    "rimraf": "^6.1.3",
    "livenui-cli": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.7",
    "tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "next": "16.x.x",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.14 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "license": "MIT AND ISC"
}
