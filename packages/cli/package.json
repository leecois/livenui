{
  "name": "livenui-cli",
  "version": "0.0.3",
  "description": "A simple CLI tool to add animation and effect components to your project.",
  "keywords": [
    "cli",
    "documentation",
    "components",
    "docs",
    "nextjs",
    "toolkit",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./build": {
      "import": "./dist/build/index.js",
      "types": "./dist/build/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "bin": {
    "livenui": "./dist/index.js"
  },
  "files": [
    "dist/*",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "bunx biome lint --write --diagnostic-level=error",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "rimraf": "^6.1.3",
    "shadcn": "^4.21.1",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
