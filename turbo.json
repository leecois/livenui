{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/licenses/**",
        "public/r/**",
        "public/registry/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "sync:search": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["LIVENUI_SYNC_SEARCH", "ORAMA_PRIVATE_API_KEY", "ORAMA_INDEX_ID"]
    }
  },
  "ui": "stream"
}
