{
  "name": "@livenui/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun build:pre && next build",
    "sync:search": "bun ./scripts/sync-search.ts",
    "build:pre": "bun ./scripts/pre-build.ts",
    "clean": "rimraf .next",
    "dev": "next dev --turbopack",
    "lint": "fumadocs-mdx && bun --preload ./scripts/preload.ts ./scripts/lint.ts && bunx biome lint --write --diagnostic-level=error",
    "postinstall": "fumadocs-mdx",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@oramacloud/client": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/helpers": "^2.14.0",
    "@takumi-rs/image-response": "^2.14.0",
    "fumadocs-core": "^16.15.18",
    "fumadocs-docgen": "^3.1.1",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-twoslash": "^4.0.1",
    "fumadocs-typescript": "^5.4.1",
    "fumadocs-ui": "^16.15.18",
    "katex": "^0.19.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "next-validate-link": "^1.6.7",
    "oxc-transform": "^0.152.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "twoslash": "^0.3.9",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5",
    "@livenui/agent-ui": "workspace:*",
    "border-beam": "workspace:*",
    "thinking-orbs": "workspace:*",
    "metal-fx": "workspace:*",
    "liquid-gooey": "workspace:*",
    "voice-glow": "workspace:*",
    "img-fx": "workspace:*",
    "bot-avatars": "workspace:*",
    "three": "^0.186.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "rimraf": "^6.1.3",
    "livenui-cli": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsconfig": "workspace:*",
    "typescript": "^7.0.2"
  }
}
